{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "Chimera_small",
        "type": "builtin",
        "padding": { "top": 2, "right": 6, "left": 3 }
    },
    "display": { "separator": " •  " },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "color": { "user": "32", "at": "37", "host": "32" }
        },
        "break", 
        {
            "type": "custom",
            "key": "distribution   ",
            "keyColor": "33",
            "format": "Chimera Linux aarch64"
        },
        {
            "type": "custom",
            "key": "linux kernel   ",
            "keyColor": "33",
            "format": "Linux 7.2.11-0-stable"
        },
        {
            "type": "command",
            "format": "{}",
            "key": "packages       ",
            "keyColor": "33",
            "text": "ls -d /var/lib/pacman/local/*/ | wc -l"
        },
        { "type": "shell", "key": "unix shell     ", "keyColor": "33" },
        { "type": "terminal", "key": "terminal       ", "keyColor": "33" },
        {
            "type": "custom",
            "key": "memory.total   ",
            "keyColor": "33",
            "format": "0.74 GiB / 15.31 GiB (5%)"
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            "key": "window manager ",
            "keyColor": "33"
        },
        "break",
    ]
}
